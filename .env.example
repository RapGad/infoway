# =============================================
# Sanity CMS Configuration
# =============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=rguazgl6
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-05-01

# =============================================
# MongoDB Configuration (Infoway Partnership Program)
# =============================================
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/infoway_partnership?retryWrites=true&w=majority

# =============================================
# Cloudflare R2 Storage (Product Photos)
# =============================================
# If not configured, product photos will fallback to saving locally in /public/uploads/products
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=infoway-products
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
